# NEO-P2P RNS Transport Node — rnsd config
# enableTransport=true: this node routes traffic for peers, passes announces,
# and serves path requests. Phones connect as TCP clients (client-only).

[reticulum]
enable_transport = Yes
share_instance = yes
panic_on_interface_error = No
discover_interfaces = no
# Stale-path self-heal (2026-09-02): when a phone's app restarts, the node
# keeps routing its traffic through the OLD dead TCP connection and never
# re-learns the new one — announces stop fanning out until the node is
# restarted. Defaults (1800s + 300s) make the dead path effectively
# permanent. Phones announce every 20s, so healthy paths refresh well
# inside these windows; only dead paths expire, and the next announce
# re-learns the path within ~3 minutes. No more manual node restarts.
path_timeout = 120
stale_path_timeout = 60
announce_interval = 360

[logging]
loglevel = 6

[interfaces]

   [[VPS TCP Server]]
     type = BackboneInterface
     enabled = Yes
     # Listen INSIDE the container on 42000 — compose publishes host 42420
     # -> container 42000 and the Dockerfile HEALTHCHECK probes 127.0.0.1:42000.
     # Change all three together or the node is unreachable/unhealthy.
     listen_ip = 0.0.0.0
     listen_port = 42000
     mode = gateway
     discoverable = no
     network_name = "neoP2P-org-mesh"
     passphrase = "yzY#QQH$bgStySaWQ3#ZvHqg&$ot$Q#yUcmgqTPKkKcYV&izfj7UKkX4`$R3kuNM"
#     discovery_name = relay1-neop2p
#     reachable_on = relay1.custom-minipc.com
     announce_rate_target = 1
     announce_rate_grace = 20
     announce_rate_penalty = 0
#   [[RMAP World]]
#     type = TCPClientInterface
#     enabled = Yes
#     target_host = rmap.world
#     target_port = 4242

# REQUIRED: only route to the LXMF propagation node (store-and-forward for
# offline peers). The propagation node exposes no host port — without this
# client link, the two nodes never connect and offline delivery is dead.
  [[Propagation Link]]
    type = TCPClientInterface
    enabled = Yes
    target_host = lxmf-propagation
    target_port = 42000
    # Same IFAC as the server: the propagation node's TCP server also
    # requires the code, so this client must present it too.
    network_name = "neoP2P-org-mesh"
    passphrase = "yzY#QQH$bgStySaWQ3#ZvHqg&$ot$Q#yUcmgqTPKkKcYV&izfj7UKkX4`$R3kuNM"
    announce_rate_target = 1
    announce_rate_grace = 20
    announce_rate_penalty = 0
