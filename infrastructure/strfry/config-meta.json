{
  "relay": {
    "name": "NEO-P2P Metadata Relay",
    "description": "NEO-P2P NIP-65 metadata relay for peer discovery",
    "pubkey": "",
    "contact": ""
  },
  "db": {
    "engine": "lmdb",
    "params": {
      "path": "/data/strfry-meta.db",
      "mapSize": "512MB"
    }
  },
  "events": {
    "maxEventSize": 4096,
    "maxEventsPerPeriod": 200,
    "eventPeriodSecs": 60,
    "maxSubscriptions": 32,
    "maxFilterOutputs": 1000,
    "maxEoseSubscriptions": 8,
    "maxNegentropyRecords": 100,
    "maxWebSocketPayloadSize": 8192
  },
  "remote": {
    "enabled": false
  },
  "ip4": {
    "trusted": [],
    "whitelist": []
  },
  "nip65": {
    "advertise": true,
    "relayUrl": "wss://meta.neop2p.io:7004"
  }
}
