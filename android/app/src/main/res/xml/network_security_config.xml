<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Deny cleartext everywhere. HTTP(S) traffic is explorer/market reads
         over TLS (cert-pinned in ExplorerPins); there is no plaintext
         destination to exempt.

         RNS/LXMF is raw TCP to the transport node. The platform network
         security policy does not govern raw sockets, so no domain-config
         here can (or needs to) authorize it. -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
