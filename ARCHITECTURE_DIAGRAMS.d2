# ──────────────────────────────────────────────
# NEO-P2P Cross-Platform Architecture Diagrams
# ──────────────────────────────────────────────

# Layer Explanation
# ──────────────────────────────────────────────

direction: right

Android Platform: "" {
  AUI: "Jetpack Compose UI / Material 3" { shape: rounded_box }
  AViewModel: "Shared ViewModel (AndroidX Lifecycle)" { shape: rounded_box }
  AStateFlow: "StateFlow/Flow / State Observers" { shape: rounded_box }

  AUI -> AViewModel
  AViewModel -> AStateFlow
}

iOS Platform: "" {
  IUI: "SwiftUI UI / Cupertino Adaptive" { shape: rounded_box }
  IViewModel: "Shared ViewModel / State Observers" { shape: rounded_box }
  IState: "Combine/Publishers / State Observers" { shape: rounded_box }

  IUI -> IViewModel
  IViewModel -> IState
}

Shared Module: "Kotlin Multiplatform Shared" {
  UIC: "Use Cases (Interactors)" { shape: rounded_box }
  REPO: "Repositories (Interfaces + Impl)" { shape: rounded_box }
  P2P: "P2P Core Layer / libp2p + Nostr + Signal + WebRTC + LDK" { shape: rounded_box }
  DATA: "Data Layer / Entities + DAOs + Local/Remote Sources" { shape: rounded_box }
  DI_KMP: "Dependency Injection / Koin KMP or Manual" { shape: rounded_box }
  UTILS: "Utilities / Constants + Extensions + Helpers" { shape: rounded_box }

  UIC -> REPO
  REPO -> P2P
  P2P -> DATA
  DATA -> DI_KMP
  DI_KMP -> UTILS
}

# Cross-boundary connections
Android Platform.AStateFlow -> Shared Module.UIC: "State Collection"
iOS Platform.IState -> Shared Module.UIC: "State Subscription"
Shared Module.UIC -> Shared Module.REPO: "Triggers"
Shared Module.REPO -> Shared Module.P2P: "Queries/Commands"
Shared Module.P2P -> Shared Module.DATA: "Events/Data"
Shared Module.DATA -> Shared Module.UIC: "Provides"

# ──────────────────────────────────────────────
# Data Flow Diagram — Offer Creation Sequence
# ──────────────────────────────────────────────

direction: down

User: "" { shape: person }

AndroidUI: "Android UI\n(Jetpack Compose)" { shape: rounded_box }
iOSUI: "iOS UI\n(SwiftUI)" { shape: rounded_box }
SharedVM: "Shared ViewModel\n(KMP)" { shape: rounded_box }
UseCases: "Use Cases\n(KMP)" { shape: rounded_box }
Repos: "Repositories\n(KMP)" { shape: rounded_box }
P2PCore: "P2P Core\n(KMP)" { shape: rounded_box }
LocalDB: "Local Database\n(SQLCipher KMP)" { shape: cylinder }
RemoteP2P: "Remote P2P\n(libp2p / WebRTC / Nostr)" { shape: cloud }

# User interaction
User -> AndroidUI: "Tap 'Create Offer'"
User -> iOSUI: "Tap 'Create Offer'"

# Android flow
AndroidUI -> SharedVM: "triggerCreateOffer()"
SharedVM -> UseCases: "CreateOfferUseCase.execute(params)"
UseCases -> Repos: "OfferRepository.save(offerDraft)"
Repos -> LocalDB: "insert(offerEntity)"
LocalDB -> Repos: "offerId" { style.stroke-dash: 3 }
Repos -> UseCases: "offerId" { style.stroke-dash: 3 }
UseCases -> SharedVM: "Result.success(offerId)" { style.stroke-dash: 3 }
SharedVM -> AndroidUI: "updateUIState(offerId)"

# iOS flow
iOSUI -> SharedVM: "triggerCreateOffer()"
SharedVM -> UseCases: "CreateOfferUseCase.execute(params)"
UseCases -> Repos: "OfferRepository.save(offerDraft)"
Repos -> LocalDB: "insert(offerEntity)"
LocalDB -> Repos: "offerId" { style.stroke-dash: 3 }
Repos -> UseCases: "offerId" { style.stroke-dash: 3 }
UseCases -> SharedVM: "Result.success(offerId)" { style.stroke-dash: 3 }
SharedVM -> iOSUI: "updateUIState(offerId)"

# P2P broadcasting
UseCases -> P2PCore: "broadcastNewOffer(offer)"
P2PCore -> RemoteP2P: "libp2p.publish(NostrEvent)"
RemoteP2P -> P2PCore: "Ack/Nack" { style.stroke-dash: 3 }
P2PCore -> UseCases: "BroadcastResult" { style.stroke-dash: 3 }

# Real-time updates
RemoteP2P -> P2PCore: "Incoming Nostr Event"
P2PCore -> Repos: "OfferRepository.updateFromEvent(event)"
Repos -> LocalDB: "update(offerEntity)"
LocalDB -> Repos: "Success" { style.stroke-dash: 3 }
Repos -> UseCases: "Updated Offer" { style.stroke-dash: 3 }
UseCases -> SharedVM: "Flow.emit(updatedOffer)" { style.stroke-dash: 3 }
SharedVM -> AndroidUI: "updateUIState(updatedOffer)"
SharedVM -> iOSUI: "updateUIState(updatedOffer)"

# ──────────────────────────────────────────────
# State Management Strategy
# ──────────────────────────────────────────────

UI Layer: "" {
  AUI_s: "Android UI / Jetpack Compose" { shape: rounded_box }
  IUI_s: "iOS UI / SwiftUI" { shape: rounded_box }
  AState: "ViewModel State" { shape: hexagon }
  IState_h: "ViewModel State" { shape: hexagon }

  AUI_s -> AState: "collectAsStateWithLifecycle()"
  IUI_s -> IState_h: "onSubscribe()"
}

ViewModel Layer: "KMP Shared" {
  VM: "Shared ViewModel / ViewModel()" { shape: rounded_box }
  StateHolder: "State Holder / MutableStateFlow / PassthroughSubject" { shape: rounded_box }
  ProcessedState: "Processed State / UI-specific transformations" { shape: rounded_box }
  SharedState_h: "Shared State Flow / StateFlow<UIState>" { shape: rounded_box }
  UseCases_s: "Use Cases / Interactors" { shape: rounded_box }

  AState -> VM: "StateFlow<UIState>"
  IState_h -> VM: "AsPublisher<UIState>"
  VM -> StateHolder: "_uiState"
  StateHolder -> ProcessedState: "map { transform }"
  ProcessedState -> SharedState_h: "distinctUntilChanged()"
  VM -> UseCases_s: "triggerEvent()"
  UseCases_s -> StateHolder: "Result/Flow" { style.stroke-dash: 3 }
}

Data Layer_s: "KMP Shared" {
  Repos_s: "Repositories" { shape: rounded_box }
  LocalDB_s: "Local Database / SQLCipher KMP" { shape: cylinder }

  Repos_s -> StateHolder: "Flow<List<Entity>>" { style.stroke-dash: 3 }
  StateHolder -> Repos_s: "save()/update()"
  Repos_s -> LocalDB_s: "DAO Operations"
  LocalDB_s -> Repos_s: "Flow<Entity>" { style.stroke-dash: 3 }
}

# ──────────────────────────────────────────────
# Dependency Injection
# ──────────────────────────────────────────────

DI Container: "Koin KMP Shared" {
  AndroidApp: "Android Application (HiltAndroidApp)" { shape: rounded_box }
  AndroidCtx: "Application Context" { shape: rounded_box }
  AndroidDI: "Android DI Module" { shape: rounded_box }

  IOSApp: "iOS Application (SwiftUI App)" { shape: rounded_box }
  IOSCtx: "iOS Context" { shape: rounded_box }
  IOSDI: "iOS DI Module" { shape: rounded_box }

  SharedDI_m: "Shared DI Module" { shape: rounded_box }

  ViewModels_di: "ViewModels / Constructor Injected" { shape: rounded_box }
  UseCases_di: "Use Cases / Constructor Injected" { shape: rounded_box }
  Repos_di: "Repositories / Constructor Injected" { shape: rounded_box }
  P2PCore_di: "P2P Core Services / Constructor Injected" { shape: rounded_box }
  LocalDB_di: "Database / SQLCipher Factory" { shape: rounded_box }
  Networking_di: "Networking Layer / Ktor Client" { shape: rounded_box }
  Utils_di: "Utilities / Helpers + Constants" { shape: rounded_box }

  AndroidApp -> AndroidCtx: "provides"
  AndroidCtx -> AndroidDI: "qualified"
  IOSApp -> IOSCtx: "provides"
  IOSCtx -> IOSDI: "qualified"
  AndroidDI -> SharedDI_m: "imports"
  IOSDI -> SharedDI_m: "imports"

  SharedDI_m -> ViewModels_di: "provides"
  SharedDI_m -> UseCases_di: "provides"
  SharedDI_m -> Repos_di: "provides"
  SharedDI_m -> P2PCore_di: "provides"
  SharedDI_m -> LocalDB_di: "provides"
  SharedDI_m -> Networking_di: "provides"
  SharedDI_m -> Utils_di: "provides"

  ViewModels_di -> UseCases_di: "requires"
  ViewModels_di -> Utils_di: "requires"
  UseCases_di -> Repos_di: "requires"
  UseCases_di -> P2PCore_di: "requires"
  Repos_di -> LocalDB_di: "requires"
  Repos_di -> Networking_di: "requires"
  P2PCore_di -> Utils_di: "requires"
}

Platform Impls: "" {
  AndroidP2P: "Android P2P Impl (libp2p/JVM)" { shape: rounded_box }
  IOSP2P: "iOS P2P Impl (libp2p/Native)" { shape: rounded_box }
  AndroidDB: "Android DB Impl (Room/SQLCipher)" { shape: rounded_box }
  IOSDB_i: "iOS DB Impl (GRDBSQLCipher)" { shape: rounded_box }
  AndroidNet: "Android Net Impl (OkHttp)" { shape: rounded_box }
  IOSNet: "iOS Net Impl (NSURLSession)" { shape: rounded_box }

  AndroidP2P -> P2PCore_di: "binds"
  IOSP2P -> P2PCore_di: "binds"
  AndroidDB -> LocalDB_di: "binds"
  IOSDB_i -> LocalDB_di: "binds"
  AndroidNet -> Networking_di: "binds"
  IOSNet -> Networking_di: "binds"
}

