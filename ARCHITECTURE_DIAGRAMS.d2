# ──────────────────────────────────────────────
# NEO-P2P — Live Architecture (Android-only)
# RNS + LXMF transport · 2-of-3 multisig escrow
# ──────────────────────────────────────────────

direction: right

# ──────────────────────────────────────────────
# 1. High Level — Trade Flow
# ──────────────────────────────────────────────

direction: right

HighLevel: "High Level — Trade Flow" {
  direction: right

  Seller: "Seller" { shape: person }
  Buyer: "Buyer" { shape: person }
  Feed: "Offer Feed\n(RNS announce digest)" { shape: cylinder }
  Escrow: "2-of-3 P2SH\nMultisig" { shape: hexagon }
  FeeWallet: "Fee Wallet\n(0.5% seller-only)" { shape: rectangle }
  Arbitrator: "Arbitrator\n(3rd key)" { shape: person }

  Seller -> Feed: "1. create offer (sell-only)"
  Buyer -> Feed: "2. browse · accept → MATCHED"
  Feed -> Escrow: "3. escrow created"
  Seller -> Escrow: "4. fund: crypto + 0.5%\n+ network fee"
  Buyer -> Seller: "5. pay IDR out-of-band\n(BCA · GoPay · cash)"
  Buyer -> Escrow: "6. send receipt (E2EE)"
  Seller -> Escrow: "7. confirm IDR received\n(ONLY release gate)"
  Escrow -> Buyer: "8. full crypto"
  Escrow -> FeeWallet: "8. 0.5% fee"
  Escrow -> Arbitrator: "dispute → signed resolution"
}

# ══════════════════════════════════════════════
# 2. System Overview
# ══════════════════════════════════════════════

System: "System Overview" {
  direction: right

  Buyer: "Buyer Phone" {
    shape: rectangle
    BApp: "NEO-P2P App\nCompose · Hilt · Room v25"
  }

  Seller: "Seller Phone" {
    shape: rectangle
    SApp: "NEO-P2P App\nCompose · Hilt · Room v25"
  }

  Arbitrator: "Arbitrator Device" {
    shape: rectangle
    AApp: "NEO-P2P App\nArbitrator Mode (3rd key)"
  }

  TransportNode: "RNS Transport Node\n(VPS · Python rnsd)" {
    shape: cloud
    T1: "BackboneInterface TCP\n0.0.0.0:42000 → public 42420"
    T2: "no IFAC (open TCP peers)"
    T3: "announce_rate_target=1"
  }

  PropNode: "LXMF Propagation Node\n(VPS · Python lxmd)" {
    shape: cloud
    P1: "store-and-forward\nfor offline peers"
    P2: "256 msgs · 30-day expiry"
  }

  Bitcoin: "Bitcoin Network" {
    shape: cloud
    B1: "2-of-3 P2SH multisig"
    B2: "Mempool / Blockstream API"
  }

  Buyer -> TransportNode: "TCP client\nannounces · paths · links"
  Seller -> TransportNode: "TCP client\nannounces · paths · links"
  Arbitrator -> TransportNode: "TCP client"
  TransportNode -> PropNode: "Propagation Link\n(TCPClientInterface)"
  Buyer -> Seller: "LXMF DIRECT\n+ Tier 1 LAN AutoInterface"
  Seller -> Arbitrator: "dispute / evidence\n(resolution back)"
  Buyer -> Bitcoin: "fund · verify · payout\n(ChainMonitor)"
  Seller -> Bitcoin: "fund · verify · payout"
}

# ══════════════════════════════════════════════
# 3. Escrow State Machine
# ══════════════════════════════════════════════

Escrow: "Escrow State Machine (forward-only, no-downgrade)" {
  direction: right

  FUNDING: "FUNDING" { shape: hexagon }
  FUNDED: "FUNDED" { shape: hexagon }
  SIGNED: "SIGNED" { shape: hexagon }
  PAYMENT_PENDING: "PAYMENT_PENDING" { shape: hexagon }
  RECEIPT_SENT: "RECEIPT_SENT" { shape: hexagon }
  CONFIRMING: "CONFIRMING" { shape: hexagon }
  RELEASED: "RELEASED" { shape: hexagon }
  CANCELLED: "CANCELLED" { shape: hexagon }
  REFUNDED: "REFUNDED" { shape: hexagon }
  DISPUTED: "DISPUTED" { shape: hexagon }
  RESOLVING: "RESOLVING" { shape: hexagon }

  FUNDING -> FUNDED: "on-chain verify\n(≥1 conf)"
  FUNDED -> SIGNED: "generatePayoutTx\n(transient)"
  SIGNED -> PAYMENT_PENDING: "buyer markPaid"
  PAYMENT_PENDING -> RECEIPT_SENT: "buyer sendReceipt"
  RECEIPT_SENT -> CONFIRMING: "seller confirmReceipt\n(ONLY release gate)"
  CONFIRMING -> RELEASED: "broadcast 2-of-3"
  FUNDING -> CANCELLED: "15 min auto / local cancel"
  FUNDED -> REFUNDED: "12 h + 12 h grace"
  PAYMENT_PENDING -> DISPUTED: "1 h + 1 h grace"
  RECEIPT_SENT -> DISPUTED: "1 h + 1 h grace"
  DISPUTED -> RESOLVING: "arbitrator resolution"
  RESOLVING -> RELEASED: "signed payout"
  RESOLVING -> REFUNDED: "signed refund"
}

# ══════════════════════════════════════════════
# 4. Transport & Messaging
# ══════════════════════════════════════════════

Transport: "Transport & Messaging (RNS + LXMF only)" {
  direction: right

  Announce: "Announce feed" {
    A1: "neop2p/offers digest\n(~200 B, commitment {v,id,h})"
    A2: "paced 2.5 s tick, round-robin"
    A3: "lxmf.delivery announce\ndisplayName = libp2p peerId"
  }

  Direct: "LXMF DIRECT links" {
    M1: "chat (E2EE)"
    M2: "offer_status · escrow_status"
    M3: "dispute · evidence · resolution"
    M4: "offer_request → offer"
    M5: "attestation · payment_receipt"
  }

  Prop: "Propagation node" {
    P1: "store-and-forward\nfor offline peers"
  }

  LAN: "Tier 1 LAN" {
    L1: "AutoInterface\nIPv6 link-local multicast + UDP"
    L2: "MulticastLock held"
  }

  Announce -> Direct: "digest → on-demand fetch"
  Direct -> Prop: "failed delivery → queued"
}
